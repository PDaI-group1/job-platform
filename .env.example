POSTGRES_USER=jobplatform-admin
POSTGRES_PASSWORD=jobplatform-password
POSTGRES_DB=jobplatform-db
POSTGRES_PORT=5432
SEED_DB=true

DATABASE_URL=postgresql://jobplatform-admin:jobplatform-password@localhost:5432/jobplatform-db

# Backend API
PORT=3000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# POST /cvs stays off until the temporary CV access token is agreed
# (docs/decisions/cv-temporary-access-token.md)
CV_UPLOAD_ENABLED=false
# Separate database for tests that write data (CV tests), see README
# TEST_DATABASE_URL=postgresql://jobplatform-admin:jobplatform-password@localhost:5432/jobplatform_test

# Matching (job requirement extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
